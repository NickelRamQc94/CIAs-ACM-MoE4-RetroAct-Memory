class EcosystemOmniBridgeEngine:
    def __init__(self, registry: dict):
        self.registry = registry
        self.timestamp = datetime.now().isoformat()
        
    def check_url_health(self, name: str, url: str) -> dict:
        """Vérifie l'accessibilité réseau d'une URL de manière sécurisée."""
        if not url.startswith("http"):
            return {"name": name, "url": url, "status": "Local / Non-HTTP", "reachable": True}
        try:
            req = urllib.request.Request(
                url,
                headers={'User-Agent': 'Mozilla/5.0 (Junior-OmniBridge-Agent/10.0)'}
            )
            with urllib.request.urlopen(req, timeout=4) as response:
                status_code = response.status
                reachable = (200 <= status_code < 400)
                return {
                    "name": name,
                    "url": url,
                    "status": f"HTTP {status_code}",
                    "reachable": reachable
                }
        except Exception as e:
            return {
                "name": name,
                "url": url,
                "status": f"Inaccessible ({type(e).__name__})",
                "reachable": False
            }

    def execute_omni_sync(self):
        """Exécute l'inspection complète et synchrone de toutes les sources primaires."""
        print("=" * 85)
        print(" 🚀 LANCEMENT DU MOTEUR OMNI-BRIDGE V10 : MÉMOIRE CHROME ACTIVE UNIVERSELLE")
        print(f" 👤 Propriétaire / Opérateur : {self.registry['metadata']['owner']}")
        print(f" 🏛️ Titre : {self.registry['metadata']['title']}")
        print(f" ⏱️ Horodatage : {self.timestamp}")
        print("=" * 85)

        total_items = 0
        healthy_items = 0

        for category, sources in self.registry["comprehensive_sources"].items():
            print(f"\n📂 [SECTION] -> {category.replace('_', ' ').upper()}")
            print("-" * 85)
            
            # Utilisation d'un ThreadPoolExecutor pour valider les liens en parallèle
            with ThreadPoolExecutor(max_workers=8) as executor:
                futures = [
                    executor.submit(self.check_url_health, item["name"], item["url"])
                    for item in sources
                ]
                results = [f.result() for f in futures]

            for res, item in zip(results, sources):
                total_items += 1
                if res["reachable"]:
                    healthy_items += 1
                    icon = "🟢"
                else:
                    icon = "🟡" # Souvent dû à des restrictions d'API GitHub/HF sur les pings simples
                
                role_desc = item.get("role", "Ressource de l'écosystème")
                print(f" {icon} [{res['status']:<20}] {res['name']}")
                print(f"    └─ Rôle : {role_desc}")
                print(f"    └─ Lien : {res['url']}")

        print("\n" + "=" * 85)
        print(f" ✨ BILAN DE LA CARTOGRAPHIE OMNI-BRIDGE :")
        print(f"    • Total des sources primaires indexées : {total_items}")
        print(f"    • Intégrité structurelle validée : {healthy_items}/{total_items}")
        print(f"    • Statut du Système : OPÉRATIONNEL & PRÊT POUR L'INJECTION LLM TOTALE")
        print("=" * 85)

    def export_omni_json(self, filename: str = "ecosystem_omni_master_index.json"):
        """Exporte l'intégralité du registre et de l'état dans un fichier JSON maître."""
        output_data = {
            "metadata": self.registry["metadata"],
            "sources": self.registry["comprehensive_sources"],
            "export_timestamp": self.timestamp
        }
        with open(filename, "w", encoding="utf-8") as f:
            json.dump(output_data, f, indent=4, ensure_ascii=False)
        print(f"\n[SUCCÈS] Registre Omni-Bridge exporté avec succès dans le fichier : {filename}")

