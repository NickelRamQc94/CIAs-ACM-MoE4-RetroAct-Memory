def fetch_json_from_api(url: str):
    """Interroge une API REST et retourne le JSON décodé."""
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": "NickelRamQc94-Dynamic-AI-Crawler/1.0",
            "Accept": "application/json"
        }
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            return json.loads(response.read().decode("utf-8"))
    except Exception as e:
        print(f"[ERREUR API] Impossible de joindre {url} -> {e}")
        return []

def get_all_github_repos(username: str) -> dict:
    """Récupère dynamiquement 100 % des dépôts GitHub (originaux + forks) par pagination."""
    all_repos = []
    page = 1
    while True:
        api_url = f"https://api.github.com/users/{username}/repos?per_page=100&page={page}&type=all"
        batch = fetch_json_from_api(api_url)
        if not batch or not isinstance(batch, list):
            break
        all_repos.extend(batch)
        if len(batch) < 100:
            break
        page += 1

    originals = []
    forks = []

    for repo in all_repos:
        entry = {
            "name": repo.get("name"),
            "full_name": repo.get("full_name"),
            "url": repo.get("html_url"),
            "api_url": repo.get("url"),
            "clone_url": repo.get("clone_url"),
            "is_fork": repo.get("fork", False),
            "description": repo.get("description") or "Aucune description",
            "language": repo.get("language") or "Multi/Markdown",
            "default_branch": repo.get("default_branch", "main"),
            "updated_at": repo.get("updated_at")
        }
        if entry["is_fork"]:
            forks.append(entry)
        else:
            originals.append(entry)

    return {
        "total_count": len(all_repos),
        "originals_count": len(originals),
        "forks_count": len(forks),
        "originals": originals,
        "forks": forks
