#!/usr/bin/env python3
"""enrichir_github.py — Enrichit les neurones GitHub avec description + topics + README."""

import json
import re
import subprocess
import sys
import time
from pathlib import Path

from pont_db import connect, extract_themes, recompute_synapses, DB_PATH

def gh_api(endpoint: str) -> dict | None:
    """Appelle gh api et retourne le JSON, ou None en cas d'erreur."""
    try:
        r = subprocess.run(
            ["gh", "api", endpoint, "--jq", "."],
            capture_output=True, text=True, timeout=30
        )
        if r.returncode != 0:
            return None
        return json.loads(r.stdout)
    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError):
        return None

def parse_repo_from_url(url: str) -> tuple[str, str] | None:
    """Extrait (owner, repo) d'une URL GitHub."""
    if not url:
        return None
    m = re.search(r"github\.com[/:]([^/]+)/([^/\.\s]+)", url)
    if not m:
        return None
    return m.group(1), m.group(2).rstrip(".")

def get_readme(owner: str, repo: str) -> str:
    """Récupère le README décodé (base64 → texte)."""
    data = gh_api(f"repos/{owner}/{repo}/readme")
    if not data or "content" not in data:
        return ""
    try:
        import base64
        return base64.b64decode(data["content"]).decode("utf-8", errors="ignore")
    except Exception:
        return ""

def enrich_one(conn, row) -> bool:
    """Enrichit un neurone. Retourne True si mis à jour."""
    parsed = parse_repo_from_url(row["url"])
    if not parsed:
        return False
    owner, repo = parsed
    print(f"  → {owner}/{repo}", end=" ", flush=True)

    data = gh_api(f"repos/{owner}/{repo}")
    if not data:
        print("(introuvable)")
        return False

    description = data.get("description") or ""
    topics = data.get("topics") or []
    readme = get_readme(owner, repo)

    # Texte enrichi pour l'extraction de thèmes
    enriched_text = " ".join([description, " ".join(topics), readme[:5000]])

    # Mise à jour du neurone
    new_desc = description or row["description"]
    conn.execute(
        "UPDATE neurons SET description = ?, enriched = 1 WHERE id = ?",
        (new_desc, row["id"])
    )

    # Ré-extraction des thèmes sur le texte enrichi
    fake_res = {
        "nom": row["nom"],
        "description": enriched_text,
        "type": row["type"],
        "url": row["url"],
    }
    themes = extract_themes(fake_res)
    # Ajouter les topics comme thèmes directs (score 3 = fort)
    for t in topics:
        themes[t.lower()] = max(themes.get(t.lower(), 0), 3)

    conn.execute("DELETE FROM themes WHERE neuron_id = ?", (row["id"],))
    for theme, score in themes.items():
        conn.execute(
            "INSERT OR REPLACE INTO themes (neuron_id, theme, score) VALUES (?, ?, ?)",
            (row["id"], theme, score)
        )
    hub = max(themes, key=themes.get) if themes else "general"
    conn.execute("UPDATE neurons SET hub = ? WHERE id = ?", (hub, row["id"]))
    print(f"✓ ({len(themes)} thèmes, {len(topics)} topics)")
    return True

def enrich_all(only_missing=False):
    conn = connect(DB_PATH)
    query = "SELECT id, nom, type, url, description FROM neurons WHERE url LIKE '%github.com%'"
    if only_missing:
        query += " AND enriched = 0"
    rows = conn.execute(query).fetchall()
    print(f"Enrichissement de {len(rows)} dépôts GitHub…\n")
    ok = 0
    for row in rows:
        try:
            if enrich_one(conn, row):
                ok += 1
                conn.commit()
                time.sleep(0.3)  # Respect rate limits
        except Exception as e:
            print(f"  [!] Erreur {row['nom'][:40]} : {e}")
    print(f"\n{ok}/{len(rows)} dépôts enrichis.")
    print("Recalcul des synapses…")
    recompute_synapses(conn)
    conn.close()

if __name__ == "__main__":
    only_missing = "--missing" in sys.argv
    enrich_all(only_missing=only_missing)
