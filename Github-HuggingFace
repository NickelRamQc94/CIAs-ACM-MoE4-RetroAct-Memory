# -----------------------------------------------------------------------------
# 2. PARSING DU FICHIER SOURCE
# -----------------------------------------------------------------------------
def parse_source(path: Path) -> list[dict]:
    """Parse le fichier texte structuré en blocs de 7 lignes par ressource."""
    if not path.exists():
        raise FileNotFoundError(f"Fichier source introuvable : {path}")

    lines = [l.rstrip() for l in path.read_text(encoding="utf-8").splitlines()]
    resources = []
    i = 0
    # Sauter l'en-tête (les 7 premières lignes)
    while i < len(lines) and not lines[i].strip().startswith("ai-research-diffusion"):
        i += 1
    if i >= len(lines):
        # Fallback : peut-être pas d'en-tête
        i = 0

    # Le fichier a 7 lignes par bloc : nom, type, url, git, commande, description, source
    while i + 6 < len(lines):
        bloc = lines[i:i + 7]
        if not bloc[0].strip():
            i += 1
            continue
        resources.append({
            "nom": bloc[0].strip(),
            "type": bloc[1].strip(),
            "url": bloc[2].strip(),
            "git": bloc[3].strip(),
            "commande": bloc[4].strip(),
            "description": bloc[5].strip(),
            "source": bloc[6].strip(),
        })
        i += 7
    return resources

# -----------------------------------------------------------------------------
# 3. EXTRACTION DES THÈMES
# -----------------------------------------------------------------------------
def extract_themes(resource: dict) -> dict[str, int]:
    """Retourne les thèmes détectés avec leur score (nombre de mots-clés matchés)."""
    text = " ".join([
        resource.get("nom", ""),
        resource.get("description", ""),
        resource.get("type", ""),
        resource.get("url", ""),
    ]).lower()
    scores = defaultdict(int)
    for theme, keywords in THEMES.items():
        for kw in keywords:
            if kw.lower() in text:
                scores[theme] += 1
    return dict(scores)

# -----------------------------------------------------------------------------
# 4. CONSTRUCTION DU GRAPHE
# -----------------------------------------------------------------------------
def build_graph(resources: list[dict]) -> dict:
    """Construit le graphe neuronal : neurones + synapses pondérées."""
    neurons = {}
    for idx, res in enumerate(resources):
        nid = f"N{idx:03d}"
        themes = extract_themes(res)
        neurons[nid] = {
            "id": nid,
            "nom": res["nom"],
            "type": res["type"],
            "url": res["url"],
            "description": res["description"],
            "source": res["source"],
            "themes": themes,
            "hub": max(themes, key=themes.get) if themes else "general",
        }

    # Construire les synapses : chaque paire partageant au moins un thème
    synapses = []
    ids = list(neurons.keys())
    for i in range(len(ids)):
        for j in range(i + 1, len(ids)):
            a, b = neurons[ids[i]], neurons[ids[j]]
            shared = set(a["themes"]) & set(b["themes"])
            if not shared:
                continue
            # Poids = somme des scores min sur chaque thème partagé
            weight = sum(
                min(a["themes"][t], b["themes"][t]) for t in shared
            )
            if weight >= 1:  # garder toutes les connexions non nulles
                synapses.append({
                    "from": a["id"],
                    "to": b["id"],
                    "themes": sorted(shared),
                    "weight": weight,
                })

    # Index inverses : thème -> liste de nœuds
    hubs = defaultdict(list)
    for nid, n in neurons.items():
        for theme in n["themes"]:
            hubs[theme].append(nid)

    return {
        "neurons": neurons,
        "synapses": sorted(synapses, key=lambda s: -s["weight"]),
        "hubs": dict(hubs),
        "meta": {
            "total_neurons": len(neurons),
            "total_synapses": len(synapses),
            "total_hubs": len(hubs),
        },
    }

# -----------------------------------------------------------------------------
# 5. REQUÊTES
# -----------------------------------------------------------------------------
def query_theme(graph: dict, theme: str, depth: int = 1) -> dict:
    """Retourne les neurones liés à un thème, avec expansion de profondeur."""
    theme = theme.lower().strip()
    # Chercher dans les hubs
    matches = set()
    for hub_theme, nids in graph["hubs"].items():
        if theme in hub_theme or hub_theme in theme:
            matches.update(nids)
    if not matches:
        # Recherche floue dans les noms et descriptions
        for nid, n in graph["neurons"].items():
            text = f"{n['nom']} {n['description']}".lower()
            if theme in text:
                matches.add(nid)

    # Expansion par voisinage
    frontier = set(matches)
    for _ in range(depth - 1):
        new_frontier = set()
        for syn in graph["synapses"]:
            if syn["from"] in frontier:
                new_frontier.add(syn["to"])
            if syn["to"] in frontier:
                new_frontier.add(syn["from"])
        frontier |= new_frontier
    matches = frontier

    result = []
    for nid in sorted(matches):
        n = graph["neurons"][nid]
        result.append({
            "id": nid,
            "nom": n["nom"],
            "type": n["type"],
            "hub": n["hub"],
            "themes": n["themes"],
            "url": n["url"],
            "description": n["description"],
        })
    return {"theme": theme, "count": len(result), "neurons": result}

# -----------------------------------------------------------------------------
# 6. PERSISTANCE
# -----------------------------------------------------------------------------
def save_graph(graph: dict, path: Path):
    path.write_text(json.dumps(graph, ensure_ascii=False, indent=2), encoding="utf-8")

def load_graph(path: Path) -> dict:
    return json.loads(path.read_text(encoding="utf-8"))

# -----------------------------------------------------------------------------
# 7. AFFICHAGE
# -----------------------------------------------------------------------------
def print_query(result: dict):
    print(f"\n═══ Requête : « {result['theme']} » — {result['count']} neurone(s) ═══\n")
    for n in result["neurons"]:
        print(f"  ● {n['id']}  {n['nom'][:60]}")
        print(f"     type : {n['type']}")
        print(f"     hub  : {n['hub']}")
        print(f"     thèmes : {', '.join(n['themes']) or '(aucun)'}")
        if n["url"] and n["url"].startswith("http"):
            print(f"     url  : {n['url']}")
        print()

def print_stats(graph: dict):
    m = graph["meta"]
    print(f"\n═══ Statistiques du graphe neuronal ═══\n")
    print(f"  Neurones  : {m['total_neurons']}")
    print(f"  Synapses  : {m['total_synapses']}")
    print(f"  Hubs      : {m['total_hubs']}\n")
    print("  Top hubs (thème : nb de neurones) :")
    hubs_sorted = sorted(graph["hubs"].items(), key=lambda x: -len(x[1]))
    for theme, nids in hubs_sorted[:20]:
        print(f"    {theme:25s} : {len(nids)}")
    print("\n  Top synapses (poids) :")
    for syn in graph["synapses"][:10]:
        a = graph["neurons"][syn["from"]]["nom"][:30]
        b = graph["neurons"][syn["to"]]["nom"][:30]
        print(f"    {syn['weight']:3d}  {a} ↔ {b}")

# -----------------------------------------------------------------------------
# 8. CLI
# -----------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="Pont neuronal pour l'écosystème Nickel/OoSK")
    parser.add_argument("--source", default="texte 106.txt", help="Fichier source")
    parser.add_argument("--graph", default="pont_neuronal.json", help="Fichier du graphe")
    parser.add_argument("--build", action="store_true", help="Construire le graphe")
    parser.add_argument("--query", help="Interroger un thème")
    parser.add_argument("--depth", type=int, default=1, help="Profondeur d'expansion")
    parser.add_argument("--stats", action="store_true", help="Afficher les statistiques")
    parser.add_argument("--export", choices=["json"], help="Exporter le graphe")
    args = parser.parse_args()

    source = Path(args.source)
    graph_path = Path(args.graph)

    if args.build:
        print(f"Lecture de {source}…")
        resources = parse_source(source)
        print(f"  {len(resources)} ressources trouvées.")
        print("Construction du graphe…")
        graph = build_graph(resources)
        save_graph(graph, graph_path)
        print(f"Graphe sauvegardé : {graph_path}")
        print_stats(graph)
        return

    if not graph_path.exists():
        print(f"Graphe absent. Lancez d'abord : python3 {sys.argv[0]} --build")
        sys.exit(1)

    graph = load_graph(graph_path)

    if args.stats:
        print_stats(graph)
    elif args.query:
        result = query_theme(graph, args.query, args.depth)
        print_query(result)
    elif args.export:
        save_graph(graph, graph_path)
        print(f"Graphe exporté : {graph_path}")
    else:
        print_stats(graph)
        print("\nCommandes disponibles :")
        print("  --build              Construire le graphe")
        print("  --query THEME        Interroger un thème")
        print("  --query THEME --depth 2")
        print("  --stats              Statistiques")

if __name__ == "__main__":
    main()
```

