7. static/graph.js — Logique D3.js

```javascript
const width = () => document.getElementById("graph").clientWidth;
const height = () => document.getElementById("graph").clientHeight;

let svg, g, simulation, linkSel, nodeSel, allNodes = [], allLinks = [];
let highlightIds = new Set();

const color = d3.scaleOrdinal(d3.schemeCategory10);

async function init() {
    const data = await fetch("/api/graph").then(r => r.json());
    allNodes = data.nodes.map(d => ({...d}));
    allLinks = data.links.map(d => ({...d}));

    const s = d3.select("#graph");
    s.selectAll("*").remove();
    svg = s.attr("viewBox", [0, 0, width(), height()]);
    g = svg.append("g");

    // Zoom / pan
    svg.call(d3.zoom().scaleExtent([0.1, 8]).on("zoom", e => g.attr("transform", e.transform)));

    simulation = d3.forceSimulation(allNodes)
        .force("link", d3.forceLink(allLinks).id(d => d.id).distance(d => 200 / Math.max(1, d.weight)))
        .force("charge", d3.forceManyBody().strength(-120))
        .force("center", d3.forceCenter(width() / 2, height() / 2))
        .force("collision", d3.forceCollide().radius(12));

    linkSel = g.append("g").attr("stroke", "#555")
        .selectAll("line").data(allLinks).join("line")
        .attr("stroke-width", d => Math.min(4, 1 + d.weight / 5))
        .attr("stroke-opacity", 0.4);

    nodeSel = g.append("g")
        .selectAll("circle").data(allNodes).join("circle")
        .attr("r", d => 6 + Math.min(8, d.degree / 2))
        .attr("fill", d => color(d.hub || "general"))
        .attr("stroke", "#fff").attr("stroke-width", 1)
        .style("cursor", "pointer")
        .on("click", (e, d) => showDetails(d))
        .call(drag(simulation));

    nodeSel.append("title").text(d => d.nom);

    simulation.on("tick", () => {
        linkSel
            .attr("x1", d => d.source.x).attr("y1", d => d.source.y)
            .attr("x2", d => d.target.x).attr("y2", d => d.target.y);
        nodeSel.attr("cx", d => d.x).attr("cy", d => d.y);
    });

    updateStats();
}

function drag(sim) {
    return d3.drag()
        .on("start", (e, d) => { if (!e.active) sim.alphaTarget(0.3).restart(); d.fx = d.x; d.fy = d.y; })
        .on("drag", (e, d) => { d.fx = e.x; d.fy = e.y; })
        .on("end", (e, d) => { if (!e.active) sim.alphaTarget(0); d.fx = null; d.fy = null; });
}

function showDetails(d) {
    const panel = document.getElementById("panel-content");
    panel.innerHTML = `
        <h3>${d.nom}</h3>
        <p><strong>Hub :</strong> <span style="color:${color(d.hub)}">${d.hub}</span></p>
        <p><strong>Type :</strong> ${d.type || "—"}</p>
        <p><strong>Degré :</strong> ${d.degree} connexions</p>
        <p><strong>ID :</strong> ${d.id}</p>
    `;
}

async function search(theme) {
    if (!theme) return resetView();
    const res = await fetch(`/api/query?theme=${encodeURIComponent(theme)}&depth=1`).then(r => r.json());
    highlightIds = new Set(res.neurons.map(n => n.id));

    nodeSel.attr("opacity", d => highlightIds.has(d.id) ? 1 : 0.15)
        .attr("r", d => highlightIds.has(d.id) ? 12 : 5);
    linkSel.attr("opacity", d =>
        highlightIds.has(d.source.id) && highlightIds.has(d.target.id) ? 0.9 : 0.05
    );
    document.getElementById("panel-content").innerHTML =
        `<h3>« ${theme} »</h3><p>${res.count} neurone(s) correspondant(s).</p>`;
}

function resetView() {
    highlightIds.clear();
    nodeSel.attr("opacity", 1).attr("r", d => 6 + Math.min(8, d.degree / 2));
    linkSel.attr("opacity", 0.4);
}

async function updateStats() {
    const st = await fetch("/api/stats").then(r => r.json());
    const top = st.hubs.slice(0, 6).map(h => `<span class="hub">${h.theme} (${h.count})</span>`).join(" ");
    document.getElementById("stats").innerHTML =
        `<strong>${st.neurons}</strong> neurones · <strong>${st.synapses}</strong> synapses · Hubs : ${top}`;
}

document.getElementById("btn-search").addEventListener("click", () => {
    search(document.getElementById("search").value.trim());
});
document.getElementById("search").addEventListener("keydown", e => {
    if (e.key === "Enter") search(e.target.value.trim());
});
document.getElementById("btn-reset").addEventListener("click", resetView);
window.addEventListener("resize", () => init());

init();
