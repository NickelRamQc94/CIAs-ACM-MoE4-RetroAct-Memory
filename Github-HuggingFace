        return jsonify({"status": "error", "message": str(e)}), 500

@app.route("/api/health")
def api_health():
    return jsonify({"status": "ok", "db": str(DB_PATH), "exists": DB_PATH.exists()})

if __name__ == "__main__":
    if not DB_PATH.exists():
        print("Base absente, construction initiale…")
        build(DB_PATH)
    print(f"Serveur sur http://127.0.0.1:5000")
