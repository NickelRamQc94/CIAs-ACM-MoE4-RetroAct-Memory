def connect(db_path=DB_PATH) -> sqlite3.Connection:
    conn = sqlite3.connect(db_path, check_same_thread=False)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn


def init_schema(conn: sqlite3.Connection):
    conn.executescript("""
        CREATE TABLE IF NOT EXISTS neurons (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nom TEXT NOT NULL UNIQUE,
            type TEXT,
            url TEXT,
            git TEXT,
            commande TEXT,
            description TEXT,
            source TEXT,
            hub TEXT,
            enriched INTEGER DEFAULT 0
        );
        CREATE TABLE IF NOT EXISTS themes (
            neuron_id INTEGER NOT NULL REFERENCES neurons(id) ON DELETE CASCADE,
            theme TEXT NOT NULL,
            score INTEGER NOT NULL DEFAULT 1,
            PRIMARY KEY (neuron_id, theme)
        );
        CREATE TABLE IF NOT EXISTS synapses (
            from_id INTEGER NOT NULL REFERENCES neurons(id) ON DELETE CASCADE,
            to_id INTEGER NOT NULL REFERENCES neurons(id) ON DELETE CASCADE,
            weight INTEGER NOT NULL,
            themes TEXT,
            PRIMARY KEY (from_id, to_id)
        );
        CREATE INDEX IF NOT EXISTS idx_themes_theme ON themes(theme);
        CREATE INDEX IF NOT EXISTS idx_syn_from ON synapses(from_id);
        CREATE INDEX IF NOT EXISTS idx_syn_to ON synapses(to_id);
    """)
    conn.commit()


def extract_themes(resource: dict) -> dict[str, int]:
    """Extrait les thèmes avec score (nb mots-clés matchés)."""
    text = " ".join([
        resource.get("nom", "") or "",
        resource.get("description", "") or "",
        resource.get("type", "") or "",
        resource.get("url", "") or "",
    ]).lower()
    scores = defaultdict(int)
    for theme, keywords in THEMES.items():
        for kw in keywords:
            if kw.lower() in text:
                scores[theme] += 1
    return dict(scores)


def parse_source(path: Path) -> list[dict]:
    """Parse le fichier structuré (7 lignes par ressource)."""
    if not path.exists():
        return []
    lines = [l.rstrip() for l in path.read_text(encoding="utf-8").splitlines()]
    resources = []
    i = 0
    # Sauter l'en-tête (7 lignes) : on cherche une ligne commençant par un nom de dépôt
    while i < len(lines) and not (lines[i].strip() and "ai-research" in lines[i].lower()):
        i += 1
    while i + 6 < len(lines):
        bloc = lines[i:i + 7]
        if not bloc[0].strip():
            i += 1
            continue
        resources.append({
            "nom": bloc[0].strip(),
            "type": bloc[1].strip(),
            "url": bloc[2].strip(),
            "git": bloc[3].strip(),
            "commande": bloc[4].strip(),
            "description": bloc[5].strip(),
            "source": bloc[6].strip(),
        })
        i += 7
    return resources


def upsert_neuron(conn, res: dict) -> int | None:
    """Insère ou met à jour un neurone. Retourne son id (None si erreur)."""
    themes = extract_themes(res)
    hub = max(themes, key=themes.get) if themes else "general"
    try:
        cur = conn.execute("""
            INSERT INTO neurons (nom, type, url, git, commande, description, source, hub)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            ON CONFLICT(nom) DO UPDATE SET
                type=excluded.type,
                url=excluded.url,
                git=excluded.git,
                commande=excluded.commande,
                description=excluded.description,
                source=excluded.source,
                hub=excluded.hub
            RETURNING id
        """, (res["nom"], res["type"], res["url"], res["git"],
              res["commande"], res["description"], res["source"], hub))
        row = cur.fetchone()
        if not row:
            return None
        nid = row[0]
        # Remplace les thèmes (pour éviter les doublons)
        conn.execute("DELETE FROM themes WHERE neuron_id = ?", (nid,))
        for theme, score in themes.items():
            conn.execute(
                "INSERT INTO themes (neuron_id, theme, score) VALUES (?, ?, ?)",
                (nid, theme, score)
            )
        return nid
    except sqlite3.Error as e:
        print(f"  [!] Erreur insertion {res['nom'][:40]} : {e}")
        return None


def recompute_synapses(conn):
    """Recalcule toutes les synapses. Paire partageant ≥1 thème."""
    conn.execute("DELETE FROM synapses")
    # Charger les thèmes par neurone
    rows = conn.execute("SELECT neuron_id, theme, score FROM themes").fetchall()
    by_neuron = defaultdict(dict)
    for r in rows:
        by_neuron[r["neuron_id"]][r["theme"]] = r["score"]

    ids = sorted(by_neuron.keys())
    for i in range(len(ids)):
        for j in range(i + 1, len(ids)):
            a, b = ids[i], ids[j]
            ta, tb = by_neuron[a], by_neuron[b]
            shared = set(ta) & set(tb)
            if not shared:
                continue
            weight = sum(min(ta[t], tb[t]) for t in shared)
            if weight < 1:
                continue
            conn.execute(
                "INSERT INTO synapses (from_id, to_id, weight, themes) VALUES (?, ?, ?, ?)",
                (a, b, weight, json.dumps(sorted(shared)))
            )
    conn.commit()


def build(db_path=DB_PATH, source=SOURCE, verbose=True):
    """Construit la base complète depuis le fichier source."""
    conn = connect(db_path)
    init_schema(conn)
    if verbose:
        print(f"Lecture de {source}…")
    resources = parse_source(source)
    if verbose:
        print(f"  {len(resources)} ressources trouvées.")
    count = 0
    for res in resources:
        if upsert_neuron(conn, res):
            count += 1
    conn.commit()
    if verbose:
        print(f"  {count} neurones insérés/mis à jour.")
        print("Calcul des synapses…")
    recompute_synapses(conn)
    if verbose:
        n = conn.execute("SELECT COUNT(*) FROM neurons").fetchone()[0]
        s = conn.execute("SELECT COUNT(*) FROM synapses").fetchone()[0]
        h = conn.execute("SELECT COUNT(DISTINCT theme) FROM themes").fetchone()[0]
        print(f"  {n} neurones, {s} synapses, {h} hubs.")
    conn.close()


# --- Requêtes ------------------------------------------------------------------
def query_theme(theme: str, depth: int = 1, db_path=DB_PATH) -> dict:
    """Retourne les neurones liés à un thème, avec expansion."""
    conn = connect(db_path)
    theme = theme.lower().strip()
    # Correspondance exacte ou partielle dans le nom du thème
    rows = conn.execute("""
        SELECT n.id, n.nom, n.type, n.url, n.description, n.hub,
               GROUP_CONCAT(t.theme, ',') AS themes
        FROM neurons n
        JOIN themes t ON t.neuron_id = n.id
        WHERE t.theme LIKE ? OR n.nom LIKE ? OR n.description LIKE ?
        GROUP BY n.id
    """, (f"%{theme}%", f"%{theme}%", f"%{theme}%")).fetchall()

    matches = {r["id"]: dict(r) for r in rows}
    for m in matches.values():
        m["themes"] = sorted(m["themes"].split(",")) if m["themes"] else []

    # Expansion par voisinage
    for _ in range(depth - 1):
        if not matches:
            break
        placeholders = ",".join("?" * len(matches))
        neighbors = conn.execute(f"""
            SELECT DISTINCT
                CASE WHEN from_id IN ({placeholders}) THEN to_id ELSE from_id END AS nid
            FROM synapses
            WHERE from_id IN ({placeholders}) OR to_id IN ({placeholders})
        """, (*matches.keys(), *matches.keys(), *matches.keys())).fetchall()
        new_ids = [n["nid"] for n in neighbors if n["nid"] not in matches]
        if not new_ids:
            break
        placeholders2 = ",".join("?" * len(new_ids))
        rows = conn.execute(f"""
            SELECT n.id, n.nom, n.type, n.url, n.description, n.hub,
                   GROUP_CONCAT(t.theme, ',') AS themes
            FROM neurons n
            LEFT JOIN themes t ON t.neuron_id = n.id
            WHERE n.id IN ({placeholders2})
            GROUP BY n.id
        """, new_ids).fetchall()
        for r in rows:
            d = dict(r)
            d["themes"] = sorted(d["themes"].split(",")) if d["themes"] else []
            matches[d["id"]] = d

    conn.close()
    return {"theme": theme, "count": len(matches), "neurons": list(matches.values())}


def get_graph(db_path=DB_PATH) -> dict:
    """Retourne {nodes, links} pour D3.js."""
    conn = connect(db_path)
    nodes = [dict(r) for r in conn.execute("""
        SELECT n.id, n.nom, n.type, n.hub,
               (SELECT COUNT(*) FROM synapses WHERE from_id = n.id OR to_id = n.id) AS degree
        FROM neurons n
    """).fetchall()]
    links = [dict(r) for r in conn.execute("""
        SELECT from_id AS source, to_id AS target, weight, themes
        FROM synapses
    """).fetchall()]
    conn.close()
    return {"nodes": nodes, "links": links}


def get_stats(db_path=DB_PATH) -> dict:
    conn = connect(db_path)
    n = conn.execute("SELECT COUNT(*) FROM neurons").fetchone()[0]
    s = conn.execute("SELECT COUNT(*) FROM synapses").fetchone()[0]
    hubs = [dict(r) for r in conn.execute("""
        SELECT theme, COUNT(*) AS count FROM themes GROUP BY theme ORDER BY count DESC
    """).fetchall()]
    top_links = [dict(r) for r in conn.execute("""
        SELECT a.nom AS a, b.nom AS b, s.weight
        FROM synapses s
        JOIN neurons a ON a.id = s.from_id
        JOIN neurons b ON b.id = s.to_id
        ORDER BY s.weight DESC LIMIT 10
    """).fetchall()]
    conn.close()
    return {"neurons": n, "synapses": s, "hubs": hubs, "top_links": top_links}


if __name__ == "__main__":
    import sys
    if "--stats" in sys.argv:
        st = get_stats()
        print(f"Neurones : {st['neurons']}")
        print(f"Synapses : {st['synapses']}")
        print("Hubs :")
        for h in st["hubs"]:
            print(f"  {h['theme']:25s} : {h['count']}")
    elif "--query" in sys.argv:
        i = sys.argv.index("--query")
        theme = sys.argv[i + 1] if i + 1 < len(sys.argv) else "ia"
        depth = int(sys.argv[i + 3]) if i + 3 < len(sys.argv) and sys.argv[i + 2] == "--depth" else 1
        res = query_theme(theme, depth)
        print(f"\n═══ « {theme} » — {res['count']} neurones ═══")
        for n in res["neurons"]:
            print(f"  ● {n['nom'][:60]:60s} [{n['hub']}]  {n['url'][:60] if n['url'] else ''}")
    else:
        build()
