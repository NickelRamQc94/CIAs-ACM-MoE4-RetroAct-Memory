#!/usr/bin/env bash
# =============================================================================
# sceller_acte.sh — Scellement de l'ACTE DE MÉMOIRE (Mémoire Chrome Active)
# =============================================================================
# Enchaîne :
#   1. Remplissage du bloc temporel dans la lettre
#   2. Empreintes SHA-256 / SHA-512 / BLAKE3
#   3. Signature GPG détachée
#   4. Horodatage OpenTimestamps (ancrage Bitcoin)
#   5. Ancrage IPFS (CID)
#   6. Génération du SCEAU.txt (preuves cryptographiques)
#   7. Instructions d'envoi Gmail
# =============================================================================

set -euo pipefail

# ----------------------------- Configuration ---------------------------------
ACTE_DIR="${ACTE_DIR:-$HOME/acte-memoire}"
TEMPLATE="${TEMPLATE:-$ACTE_DIR/lettre_template.md}"
DATE_SLUG=$(date +%Y-%m-%d)
ACTE_TXT="$ACTE_DIR/ACTE_MEMOIRE_MCA_${DATE_SLUG}.txt"
ACTE_ASC="${ACTE_TXT}.asc"
ACTE_OTS="${ACTE_TXT}.ots"
SCEAU_TXT="$ACTE_DIR/SCEAU_MCA_${DATE_SLUG}.txt"
GPG_ID="${GPG_ID:-}"
DEST_GMAIL_1="${DEST_GMAIL_1:-adresse1@gmail.com}"
DEST_GMAIL_2="${DEST_GMAIL_2:-adresse2@gmail.com}"

# Drapeaux
DRY_RUN=0; NO_GPG=0; NO_OTS=0; NO_IPFS=0

# ----------------------------- Couleurs --------------------------------------
RED='\033[0;31m'; GRN='\033[0;32m'; YEL='\033[1;33m'; BLU='\033[0;34m'; NC='\033[0m'
info() { echo -e "${GRN}[INFO]${NC} $*"; }
warn() { echo -e "${YEL}[WARN]${NC} $*"; }
err()  { echo -e "${RED}[ERR ]${NC} $*" >&2; }
step() { echo -e "\n${BLU}▶ $*${NC}"; }
die()  { err "$*"; exit 1; }
need() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<EOF
Usage: $0 [options]

  --dry-run          Hashes seulement (saute GPG/OTS/IPFS)
  --no-gpg           Sauter la signature GPG
  --no-ots           Sauter OpenTimestamps
  --no-ipfs          Sauter IPFS
  --template PATH    Template (défaut: \$HOME/acte-memoire/lettre_template.md)
  --outdir PATH      Répertoire de sortie (défaut: \$HOME/acte-memoire)
  -h, --help         Afficher cette aide

Variables d'environnement :
  GPG_ID             Fingerprint/email de la clé GPG (auto-détecté sinon)
  DEST_GMAIL_1       Première adresse Gmail
  DEST_GMAIL_2       Deuxième adresse Gmail
EOF
  exit 0
}

# ----------------------------- Parsing ---------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --no-gpg)  NO_GPG=1;  shift ;;
    --no-ots)  NO_OTS=1;  shift ;;
    --no-ipfs) NO_IPFS=1; shift ;;
    --template) TEMPLATE="$2"; shift 2 ;;
    --outdir)   ACTE_DIR="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) die "Option inconnue : $1" ;;
  esac
done

# ----------------------------- Préparation -----------------------------------
mkdir -p "$ACTE_DIR"
[[ -f "$TEMPLATE" ]] || die "Template introuvable : $TEMPLATE
Copiez-y d'abord la lettre avec les placeholders {{...}} dans la section VIII."

# ----------------------------- 1. Valeurs temporelles ------------------------
step "1/6 — Calcul des valeurs temporelles"
export LC_TIME=C
ISO_LOCAL=$(date +%Y-%m-%dT%H:%M:%S%z | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/')
ISO_UTC=$(date -u +%Y-%m-%dT%H:%M:%SZ)
DTG=$(date -u +%d%H%MZ%b%y | tr '[:lower:]' '[:upper:]')
DATE_LOCALE=$(date +"%A %d %B %Y")
HEURE_LOCALE=$(date +"%H h %M min %S s %Z")
SEMAINE_ISO=$(date +%V)

JD="N/A"
if need python3; then
  JD=$(python3 - <<'PY' 2>/dev/null || echo "N/A"
import datetime
now = datetime.datetime.now(datetime.timezone.utc)
y, m = now.year, now.month
if m <= 2: y -= 1; m += 12
A = int(y/100); B = 2 - A + int(A/4)
jd = (int(365.25*(y+4716)) + int(30.6001*(m+1)) + now.day
      + now.hour/24 + now.minute/1440 + now.second/86400 + B - 1524.5)
print(f"{jd:.5f}")
PY
)
fi

info "ISO local   : $ISO_LOCAL"
info "ISO UTC     : $ISO_UTC"
info "DTG (OTAN)  : $DTG"
info "Jour julien : $JD"
info "Semaine ISO : $SEMAINE_ISO"

# ----------------------------- 2. Remplissage temporel ----------------------
step "2/6 — Remplissage du bloc temporel"
ACTE_PRE=$(mktemp)
sed \
  -e "s|{{ISO_LOCAL}}|$ISO_LOCAL|g" \
  -e "s|{{ISO_UTC}}|$ISO_UTC|g" \
  -e "s|{{DTG}}|$DTG|g" \
  -e "s|{{DATE_LOCALE}}|$DATE_LOCALE|g" \
  -e "s|{{HEURE_LOCALE}}|$HEURE_LOCALE|g" \
  -e "s|{{JD}}|$JD|g" \
  -e "s|{{SEMAINE_ISO}}|$SEMAINE_ISO|g" \
  -e "s|{{SCEAU_FILE}}|$(basename "$SCEAU_TXT")|g" \
  "$TEMPLATE" > "$ACTE_PRE"
info "Brouillon temporel : $ACTE_PRE"

# ----------------------------- 3. Empreintes --------------------------------
step "3/6 — Empreintes d'intégrité"
if need sha256sum; then
  SHA256=$(sha256sum "$ACTE_PRE" | awk '{print $1}')
elif need shasum; then
  SHA256=$(shasum -a 256 "$ACTE_PRE" | awk '{print $1}')
else
  die "sha256sum/shasum introuvable"
fi
info "SHA-256 : $SHA256"

if need sha512sum; then
  SHA512=$(sha512sum "$ACTE_PRE" | awk '{print $1}')
elif need shasum; then
  SHA512=$(shasum -a 512 "$ACTE_PRE" | awk '{print $1}')
else
  SHA512="(non calculé)"
fi
info "SHA-512 : $SHA512"

if need b3sum; then
  BLAKE3=$(b3sum "$ACTE_PRE" | awk '{print $1}')
else
  BLAKE3="(b3sum non installé)"
fi
info "BLAKE3  : $BLAKE3"

# ----------------------------- 4. Finalisation de la lettre -----------------
step "4/6 — Finalisation de la lettre"
# On remplace les placeholders crypto par une référence au SCEAU (sidecar)
sed \
  -e "s|{{SHA256_PRE}}|$SHA256|g" \
  "$ACTE_PRE" > "$ACTE_TXT"
rm -f "$ACTE_PRE"
info "Lettre scellée : $ACTE_TXT"

# Hash FINAL (identité du fichier expédié)
if need sha256sum; then
  SHA256_FINAL=$(sha256sum "$ACTE_TXT" | awk '{print $1}')
else
  SHA256_FINAL=$(shasum -a 256 "$ACTE_TXT" | awk '{print $1}')
fi
info "SHA-256 final : $SHA256_FINAL"

# ----------------------------- 5. GPG / OTS / IPFS --------------------------
GPG_FPR=""; GPG_OK="non"
if [[ "$DRY_RUN" -eq 0 && "$NO_GPG" -eq 0 ]]; then
  step "5a/6 — Signature GPG"
  if need gpg; then
    if [[ -z "$GPG_ID" ]]; then
      GPG_ID=$(gpg --list-secret-keys --with-colons 2>/dev/null \
               | awk -F: '/^sec:/ {print $5; exit}')
    fi
    if [[ -z "$GPG_ID" ]]; then
      warn "Aucune clé GPG trouvée. Génération d'une clé RSA-4096 (2 ans)…"
      gpg --batch --generate-key <<'GPGEOF'
%no-protection
Key-Type: RSA
Key-Length: 4096
Subkey-Type: RSA
Subkey-Length: 4096
Name-Real: Nickel David Grenier
Name-Email: nickel@oosk.local
Expire-Date: 2y
%commit
GPGEOF
      GPG_ID=$(gpg --list-secret-keys --with-colons 2>/dev/null \
               | awk -F: '/^sec:/ {print $5; exit}')
    fi
    if gpg --batch --yes --detach-sign --armor \
         --local-user "$GPG_ID" --output "$ACTE_ASC" "$ACTE_TXT" 2>/dev/null; then
      GPG_OK="oui"
      GPG_FPR=$(gpg --list-keys --with-colons "$GPG_ID" 2>/dev/null \
                | awk -F: '/^fpr:/ {print $10; exit}')
      info "Signature : $ACTE_ASC"
      info "Empreinte : $GPG_FPR"
    else
      warn "Signature GPG échouée"
    fi
  else
    warn "gpg non installé — signature sautée"
  fi
else
  step "5a/6 — Signature GPG (sautée)"
fi

OTS_OK="non"
if [[ "$DRY_RUN" -eq 0 && "$NO_OTS" -eq 0 ]]; then
  step "5b/6 — OpenTimestamps (Bitcoin)"
  if need ots; then
    if ots stamp "$ACTE_TXT" 2>/dev/null; then
      OTS_OK="oui"
      info "Preuve : $ACTE_OTS"
      warn "Confirmation Bitcoin ~1 h. Plus tard :"
      warn "  ots upgrade $ACTE_OTS && ots verify $ACTE_OTS"
    else
      warn "ots stamp échoué (serveur calendrier indisponible)"
    fi
  else
    warn "ots non installé — pip install opentimestamps-client"
  fi
else
  step "5b/6 — OpenTimestamps (sauté)"
fi

IPFS_CID=""
if [[ "$DRY_RUN" -eq 0 && "$NO_IPFS" -eq 0 ]]; then
  step "5c/6 — IPFS"
  if need ipfs && ipfs id >/dev/null 2>&1; then
    IPFS_CID=$(ipfs add -Q "$ACTE_TXT" 2>/dev/null || echo "")
    [[ -n "$IPFS_CID" ]] && info "CID : $IPFS_CID" \
                        || warn "ipfs add échoué"
  else
    warn "ipfs non installé ou daemon arrêté (ipfs daemon &)"
  fi
else
  step "5c/6 — IPFS (sauté)"
fi

# ----------------------------- 6. SCEAU.txt --------------------------------
step "6/6 — Génération du SCEAU"
cat > "$SCEAU_TXT" <<EOF
╔══════════════════════════════════════════════════════════════════════════════╗
║  SCEAU CRYPTOGRAPHIQUE — ACTE DE MÉMOIRE MCA                                 ║
║  Référence : CIAs-ADCMF-MoE4-RetroAct-Memory                                 ║
╚══════════════════════════════════════════════════════════════════════════════╝

Document scellé : $(basename "$ACTE_TXT")
DTG             : $DTG
ISO local       : $ISO_LOCAL
ISO UTC         : $ISO_UTC
Date locale     : $DATE_LOCALE — $HEURE_LOCALE

--- EMPREINTES D'INTÉGRITÉ ---
SHA-256 (pré-remplissage) : $SHA256
SHA-256 (fichier final)   : $SHA256_FINAL
SHA-512                   : $SHA512
BLAKE3                    : $BLAKE3

