# vqe_paramshift_qiskit.py
# Usage: python vqe_paramshift_qiskit.py
# Requirements: pip install qiskit numpy scipy

import numpy as np
from qiskit import QuantumCircuit
from qiskit.quantum_info import SparsePauliOp, Statevector
from scipy.optimize import minimize
import time

np.random.seed(42)

# -------------------------
# 1) Définition de l'Hamiltonien (exemple 2-qubits Ising-like)
# H = Z0 + Z1 + 0.5 * X0 X1
# Représentation via SparsePauliOp
# -------------------------
paulis = [("Z I".replace(" ", ""), 1.0), ("I Z".replace(" ", ""), 1.0), ("X X".replace(" ", ""), 0.5)]
# Convert to SparsePauliOp: Qiskit expects strings like "ZI", "IZ", "XX"
H = SparsePauliOp.from_list([("ZI", 1.0), ("IZ", 1.0), ("XX", 0.5)])

# Convert to dense matrix for expectation evaluation (small n)
H_mat = H.to_matrix()

# -------------------------
# 2) Ansatz hardware-aware (layers of Ry + CZ entangling)
# -------------------------
def ansatz_circuit(n_qubits, n_layers, theta):
    """
    theta shape: (n_layers, n_qubits) flattened as length n_layers*n_qubits
    """
    qc = QuantumCircuit(n_qubits)
    # initial hadamards to create superposition (optional)
    for q in range(n_qubits):
        qc.h(q)
    idx = 0
    for layer in range(n_layers):
        # single-qubit rotations
        for q in range(n_qubits):
            qc.ry(theta[idx], q)
            idx += 1
        # entangling: chain of CZ (hardware-aware)
        for q in range(n_qubits - 1):
            qc.cz(q, q+1)
    return qc

# -------------------------
# 3) Energy evaluation via statevector
# -------------------------
def energy_from_theta(theta, n_qubits, n_layers):
    qc = ansatz_circuit(n_qubits, n_layers, theta)
    sv = Statevector.from_instruction(qc).data  # numpy array
    # expectation <psi|H|psi>
    e = np.vdot(sv, H_mat.dot(sv)).real
    return e

# -------------------------
# 4) Paramètre-shift gradient
# -------------------------
def param_shift_grad(theta, n_qubits, n_layers):
    grad = np.zeros_like(theta)
    shift = np.pi / 2.0
    for i in range(len(theta)):
        thp = theta.copy()
        thm = theta.copy()
        thp[i] += shift
        thm[i] -= shift
        ep = energy_from_theta(thp, n_qubits, n_layers)
        em = energy_from_theta(thm, n_qubits, n_layers)
        grad[i] = 0.5 * (ep - em)
    return grad

# -------------------------
# 5) Optimization wrapper
# -------------------------
def run_vqe(n_qubits=2, n_layers=2, maxiter=200):
    n_params = n_layers * n_qubits
    theta0 = 0.1 * np.random.randn(n_params)  # small init to mitigate barren plateaus
    history = {"energy": [], "theta": [], "time": []}

    def obj(theta):
        e = energy_from_theta(theta, n_qubits, n_layers)
        history["energy"].append(e)
        history["theta"].append(theta.copy())
        history["time"].append(time.time())
        return e

    def jac(theta):
        return param_shift_grad(theta, n_qubits, n_layers)

    print(f"Starting VQE: n_qubits={n_qubits}, n_layers={n_layers}, n_params={n_params}")
    res = minimize(obj, theta0, method='BFGS', jac=jac, options={'maxiter': maxiter, 'disp': True})
    print("Optimization finished.")
    print("Final energy:", res.fun)
    print("Final theta:", res.x)
    return res, history

# -------------------------
# 6) Main
# -------------------------
if __name__ == "__main__":
    res, history = run_vqe(n_qubits=2, n_layers=2, maxiter=100)
    # Validation: exact diagonalization for small system
    eigvals = np.linalg.eigvalsh(H_mat)
    print("Exact ground energy (diag):", np.min(eigvals))
    # Save history for inspection
    import json
    hist_serializable = {"energy": [float(e) for e in history["energy"]]}
    with open("vqe_history.json", "w") as f:
        json.dump(hist_serializable, f)
    print("History saved to vqe_history.json")
