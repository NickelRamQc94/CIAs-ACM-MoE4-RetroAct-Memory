@dataclass
class PatternBaseline:
"""Un pattern mémorisé."""

nom: str

vecteur_moyen: List\[float\]      # centroïde des échantillons

ecart_type: List\[float\]         # variance naturelle du pattern

nb_echantillons: int

derniere_mise_a_jour: str

classification: str             # "normal", "suspect", "hostile"

seuil_tolerance: float          # combien d'écarts-types avant alerte
class MicroPatternHunter:
def \__init_\_(self):

    self.bibliotheque: dict = {}        # patterns connus

    self.memoire_vive = deque(maxlen=1000)  # flux récent

    self.alertes = deque(maxlen=100)

    self.seuil_alerte_global = 3.0      # nombre d'écarts-types

def apprendre(self, nom: str, echantillons: List\[List\[float\]\]):

    """

    Enregistre un pattern à partir d'échantillons.

    Calcule le centroïde et l'écart-type naturel.

    """

    if len(echantillons) \< 5:

        print(f"\[!\] {nom} : besoin d'au moins 5 échantillons pour l'apprentissage")

        return

    matrice = np.array(echantillons)

    vecteur_moyen = np.mean(matrice, axis=0).tolist()

    ecart_type = np.std(matrice, axis=0).tolist()

    self.bibliotheque\[nom\] = PatternBaseline(

        nom=nom,

        vecteur_moyen=vecteur_moyen,

        ecart_type=ecart_type,

        nb_echantillons=len(echantillons),

        derniere_mise_a_jour=datetime.now().isoformat(),

        classification="normal",

        seuil_tolerance=2.0

    )

    print(f"\[+\] Pattern '{nom}' mémorisé ({len(echantillons)} échantillons)")

def analyser(self, vecteur: List\[float\], source: str = "inconnu") -\> dict:

    """

    Compare un vecteur à TOUS les patterns connus.

    Retourne le plus proche et la distance (en écarts-types).

    """

    meilleur_pattern = None

    meilleure_distance = float('inf')

    meilleur_score = 0.0

    for nom, pattern in self.bibliotheque.items():

        distance, score_normalise = self.\_distance_normalisee(vecteur, pattern)

        if distance \< meilleure_distance:

            meilleure_distance = distance

            meilleur_pattern = nom

            meilleur_score = score_normalise

    \# Stockage dans la mémoire vive

    self.memoire_vive.append({

        "temps": datetime.now().isoformat(),

        "source": source,

        "vecteur": vecteur,

        "pattern_proche": meilleur_pattern,

        "score_anomalie": meilleur_score

    })

    \# Alerte si anormal

    alerte = False

    if meilleur_score \> self.seuil_alerte_global:

        alerte = True

        self.alertes.append({

            "temps": datetime.now().isoformat(),

            "pattern": meilleur_pattern,

            "score": meilleur_score,

            "source": source,

            "details": f"Écart de {meilleur_score:.1f} écarts-types"

        })

    return {

        "pattern_proche": meilleur_pattern,

        "score_anomalie": meilleur_score,

        "alerte": alerte,

        "source": source

    }

def \_distance_normalisee(self, vecteur: List\[float\], pattern: PatternBaseline) -\> Tuple\[float, float\]:

    """

    Calcule la distance de Mahalanobis simplifiée :

    pour chaque dimension, on mesure l'écart en nombre d'écarts-types.

    """

    if len(vecteur) != len(pattern.vecteur_moyen):

        return float('inf'), float('inf')

    distances = \[\]

    for i in range(len(vecteur)):

        ecart = vecteur\[i\] - pattern.vecteur_moyen\[i\]

        if pattern.ecart_type\[i\] \> 0:

            distances.append(abs(ecart) / pattern.ecart_type\[i\])

        else:

            distances.append(0.0 if ecart == 0 else float('inf'))

    score_global = max(distances)  # la pire dimension

    distance_euclidienne = math.sqrt(sum(d\*d for d in distances))

    return distance_euclidienne, score_global

