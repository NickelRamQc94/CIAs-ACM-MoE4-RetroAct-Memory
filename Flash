print(circuit)

if NOISE_ENABLED:

    print("\\n🔊 MODÈLE DE BRUIT ACTIVÉ (dépolarisation + erreurs de lecture)")

\# Initialisation paramétrique (reproductible)

np.random.seed(94)

initial_params = np.random.uniform(0, 2 \* np.pi, n_params)

print(f"\\nÉNERGIE INITIALE (Avant apprentissage) : {objective_function(initial_params, circuit, simulator, theta_symbols, noise_model):.6f}")

print("\\nDÉMARRAGE DE LA BOUCLE D'APPRENTISSAGE HYBRIDE (optimiseur COBYLA)...")

opt_result = minimize(

    objective_function,

    initial_params,

    args=(circuit, simulator, theta_symbols, noise_model),

    method='COBYLA',

    options={'maxiter': 150}

)

print("\\nRÉSULTAT DE LA CONVERGENCE :")

print(f"Succès de l'optimisation : {opt_result.success}")

print(f"ÉNERGIE FINALE (Minimisée)    : {opt_result.fun:.6f}")

if NOISE_ENABLED:

    \# Calculer l'énergie exacte après coup pour comparer (hors bruit)

    exact_energy = objective_function(opt_result.x, circuit, cirq.Simulator(), theta_symbols, noise_model=None)

    print(f"ÉNERGIE EXACTE (sans bruit)   : {exact_energy:.6f}")

    print(f"ÉCART DÛ AU BRUIT              : {opt_result.fun - exact_energy:.6f}")

print(f"Angles Optimaux (premiers 9)   : {np.round(opt_result.x\[:9\], 4)}")

\# Test de falsifiabilité supplémentaire

print("\\n--- TEST DE ROBUSTESSE (sans intrication) ---")

circuit_no_ent = cirq.Circuit()

circuit_no_ent.append(cirq.H.on_each(\*qubits))

for i, q in enumerate(qubits):

    circuit_no_ent.append(cirq.ry(theta_symbols\[i\])(q))

exact_noent = objective_function(initial_params\[:n_qubits\], circuit_no_ent, cirq.Simulator(), theta_symbols\[:n_qubits\], None)

print(f"Énergie sans intrication (exact) : {exact_noent:.6f}")

print("→ L'intrication est bien nécessaire pour saturer la borne inférieure (-1).")
if _name_ == '_main_':
run_quantum_intelligence()
