import cirq
import sympy
import numpy as np
from scipy.optimize import minimize
# ==========================================
# 1. ARCHITECTURE MATÉRIELLE (TOPOLOGIE WILLOW ÉLARGIE)
# ==========================================
# Grille 3x3 de qubits supraconducteurs, comme une vraie puce.
qubits = cirq.GridQubit.rect(3, 3) # 9 qubits
# ==========================================
# 2. MODÈLE DE BRUIT (DONNÉES TYPIQUES WILLOW)
# ==========================================
def create_noise_model():
"""

Crée un modèle de bruit basé sur les performances réelles de Willow :

- Portes à 2 qubits : fidélité moyenne \~99.6%

- Portes à 1 qubit : fidélité \> 99.9%

- Lectures : fidélité \> 99.0%

"""

noise = cirq.ConstantQubitNoiseModel(

    qubit_noise_gate=cirq.DepolarizingChannel(0.001),  # 0.1% d'erreur par porte 1q

    readout_noise=cirq.BitFlipChannel(0.01)           # 1% d'erreur de lecture

)

\# Ajouter un bruit dédié aux portes à deux qubits (plus élevé)

two_q_noise = cirq.DepolarizingChannel(0.004)  # 0.4% d'erreur

\# Pour l'appliquer seulement aux portes CZ, nous devons construire un modèle de bruit personnalisé.

\# Pour rester simple, nous utilisons le même modèle sur toutes les portes, mais l'erreur 1q est faible.

return noise
# Activation du bruit (désactivable pour tester la pureté)
NOISE_ENABLED = True
# ==========================================
# 3. LOGIQUE QUANTIQUE (HARDWARE-EFFICIENT ANSATZ)
# ==========================================
def create_quantum_neural_network(qubits, theta_symbols):
"""

Construit un ansatz "hardware-efficient" en couches,

typique des processeurs supraconducteurs comme Willow.

- Couche 1 : Superposition

- Couches suivantes : Intrication sur la grille + rotations paramétrées

"""

circuit = cirq.Circuit()

n = len(qubits)

p = 2  # nombre de couches répétées (profondeur)

\# Couche initiale de superposition

circuit.append(cirq.H.on_each(\*qubits))

\# Boucle sur les couches

idx = 0

for layer in range(p):

    \# Intrication : CZ entre voisins horizontaux et verticaux

    for q in qubits:

        \# Voisin de droite

        right = cirq.GridQubit(q.row, q.col + 1)

        if right in qubits:

            circuit.append(cirq.CZ(q, right))

        \# Voisin du bas

        down = cirq.GridQubit(q.row + 1, q.col)

        if down in qubits:

            circuit.append(cirq.CZ(q, down))

    \# Rotations paramétrées sur tous les qubits (chaque paramètre est utilisé une fois)

    for q in qubits:

        circuit.append(cirq.ry(theta_symbols\[idx\])(q))

        idx += 1

\# S'assurer que le nombre de paramètres correspond exactement

\# Pour 9 qubits et 2 couches, on a 9\*2=18 paramètres.

\# Si le nombre de symboles fourni est plus grand, on les ignore.

return circuit
# ==========================================
# 4. OBSERVABLE (PROBLÈME TEST)
# ==========================================
# Minimisation de l'énergie de <Z_0 Z_1 ... Z_8> : état fondamental |000...0> (énergie -1)
pauli_strings = [cirq.Z(q) for q in qubits]
observable = pauli_strings[0]
for p in pauli_strings[1:]:
observable \*= p
# ==========================================
# 5. MITIGATION D'ERREUR DE LECTURE (CORRECTION MATRICIELLE SIMPLE)
# ==========================================
def apply_readout_mitigation(expectation, readout_error=0.01):
"""

Corrige l'effet du bit-flip symétrique lors de la lecture.

Si p est la proba d'erreur de lecture, l'espérance mesurée m est

m = (1-2p) \* expectation vraie.

On estime donc l'espérance corrigée = m / (1-2p).

"""

corrected = expectation / (1 - 2\*readout_error)

return corrected
# ==========================================
# 6. BOUCLE D'INTELLIGENCE HYBRIDE (VQE AVEC BRUIT ET MITIGATION)
# ==========================================
def objective_function(params, circuit, simulator, theta_symbols, noise_model=None):
"""

Exécute le circuit (avec ou sans bruit) et retourne l'énergie corrigée.

"""

resolver = cirq.ParamResolver({sym.name: val for sym, val in zip(theta_symbols, params)})

if NOISE_ENABLED and noise_model is not None:

    \# Simulation Monte-Carlo avec bruit

    result = simulator.simulate(

        circuit.with_noise(noise_model),

        param_resolver=resolver,

        qubit_order=qubits

    )

    \# Dans le cas bruité, nous devons utiliser la mesure pour obtenir l'espérance

    \# car l'état est un mélange statistique.

    \# On utilise expectation_from_density_matrix

    rho = result.final_density_matrix

    expectation = observable.expectation_from_density_matrix(rho, qubit_map={q: i for i, q in enumerate(qubits)})

else:

    \# Simulation exacte par vecteur d'état

    result = simulator.simulate(circuit, resolver)

    expectation = observable.expectation_from_state_vector(

        result.final_state_vector,

        qubit_map={q: i for i, q in enumerate(qubits)}

    )

energy = np.real(expectation)

\# Appliquer mitigation de lecture si bruitée

if NOISE_ENABLED and noise_model is not None:

    energy = apply_readout_mitigation(energy, readout_error=0.01)

return energy
# ==========================================
# 7. EXÉCUTION ET FALSIFICATION
# ==========================================
def run_quantum_intelligence():
print("INITIALISATION DU SYSTÈME LOGIQUE (SIMULATEUR WILLOW ENRICHÉ)")

simulator = cirq.DensityMatrixSimulator() if NOISE_ENABLED else cirq.Simulator()

\# Préparation des symboles

\# Nombre de paramètres = nombre de qubits \* nombre de couches

n_qubits = len(qubits)

n_layers = 2

n_params = n_qubits \* n_layers

theta_symbols = sympy.symbols(f'theta_0:{n_params}')

circuit = create_quantum_neural_network(qubits, theta_symbols)

\# Modèle de bruit (si activé)

noise_model = create_noise_model() if NOISE_ENABLED else None

